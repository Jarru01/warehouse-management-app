# Production settings for docker compose on a server.
#   cp .env.prod.example .env      then fill in every value marked REQUIRED.
# Keep .env private (chmod 600 .env); Git ignores it.

# --- Domain (REQUIRED) -------------------------------------------------------
# Public domain whose DNS A/AAAA record points to this server. Caddy obtains the
# HTTPS certificate for it automatically.
DOMAIN=sklad.example.com

# --- Secrets (REQUIRED) ------------------------------------------------------
# Database password. Used only when the database is created for the first time;
# changing it later also requires changing it inside PostgreSQL.
DB_PASSWORD=change-me-long-random-database-password
# Temporary password of the seeded director (at least 8 characters).
WAREHOUSE_RIADITEL_HESLO=change-me-temporary-director-password

# --- E-mail for password recovery (REQUIRED) ---------------------------------
# Any SMTP provider (Brevo, Mailgun, Amazon SES, your mail host, ...).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=smtp-user
MAIL_PASSWORD=smtp-password
MAIL_FROM=Warehouse App <noreply@sklad.example.com>
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# --- Backups ----------------------------------------------------------------
# Daily backup time in UTC and retention (number of copies kept).
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Directory on the server for backup files.
BACKUP_DIR=./backups

# Off-site copy (strongly recommended): any S3-compatible storage. Leave
# BACKUP_OFFSITE empty to keep backups only on this server.
# Example for Backblaze B2 (S3 API):
# BACKUP_OFFSITE=offsite:my-bucket/warehouse
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=key-id
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=application-key
# RCLONE_CONFIG_OFFSITE_ENDPOINT=s3.eu-central-003.backblazeb2.com
# RCLONE_CONFIG_OFFSITE_REGION=eu-central-003

# Monitoring of backups (optional): URL called after every successful backup,
# e.g. a healthchecks.io check or an Uptime Kuma push monitor.
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/your-uuid
