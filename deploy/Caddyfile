# HTTPS reverse proxy in front of the application container.
#
# Locally SITE_ADDRESS is unset, so the site is "localhost": Caddy signs the
# certificate with its own local authority (browsers warn until it is trusted).
# On a server compose.prod.yaml sets SITE_ADDRESS to the public domain, and
# Caddy obtains and renews a Let's Encrypt certificate automatically and
# redirects HTTP to HTTPS.
{$SITE_ADDRESS:localhost} {
	encode gzip
	reverse_proxy app:8080

	log {
		output stdout
		format console
	}
}
