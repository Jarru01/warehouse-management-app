@startuml
'https://plantuml.com/class-diagram
skinparam classAttributeIconSize 0

package "warehouse.domain" {
  abstract class Miestnost <<Entity>> {
  -kluc: String
  --
  +getKluc(): String
  +{abstract}getTyp(): TypMiestnosti
  }

  enum TypMiestnosti {
  VELKY
  MALY
  }

  class VelkySklad <<Entity>>
  class MalySklad <<Entity>>

  class Regal <<Entity>> {
  -id: Long
  -kapacita: int
  --
  +getId(): Long
  +getMiestnost(): Miestnost
  +getKapacita(): int
  }

  class ZakaznikInfo <<Embeddable>> {
  -id: String
  -meno: String
  -priezvisko: String
  }

  class Tovar <<Entity>> {
  -id: String
  -nazov: String
  -vaha: int
  -odosielatel: ZakaznikInfo
  -prijemca: ZakaznikInfo
  -regal: Regal
  -slot: Integer
  --
  +ulozDoRegalu(regal: Regal, slot: int): void
  +vyberZRegalu(): void
  }

  abstract class Osoba <<MappedSuperclass>> {
  #meno: String
  #priezvisko: String
  --
  +getMeno(): String
  +getPriezvisko(): String
  }

  class Pracovnik <<Entity>> {
  -id: String
  -miestnost: Miestnost
  -drzanyTovar: Tovar
  --
  +premiestniDo(miestnost: Miestnost): void
  +uchop(tovar: Tovar): void
  +poloz(): void
  +drziTovar(): boolean
  }

  class Riaditel <<Entity>> {
  -id: String
  }
}

package "warehouse.repository" {
  interface MiestnostRepository
  interface RegalRepository
  interface TovarRepository
  interface PracovnikRepository
  interface RiaditelRepository
}

package "warehouse.service" {
  class SkladService {
  +miestnosti(): List<Miestnost>
  +miestnost(kluc: String): Miestnost
  +pracovnici(): List<Pracovnik>
  +pracovnik(id: String): Pracovnik
  +riaditel(id: String): Riaditel
  +tovar(id: String): Tovar
  +regale(kluc: String): List<Regal>
  +tovarVRegali(regalId: Long): List<Tovar>
  +tovarPreZakaznika(zakaznikId: String): List<Tovar>
  +prijmiPracovnika(id: String, meno: String, priezvisko: String): Pracovnik
  +vylucPracovnika(id: String): void
  +pridajRegal(kapacita: int): Regal
  +odstranRegal(regalId: Long): void
  +presunPracovnika(pracovnikId: String, kluc: String): Pracovnik
  +zoberTovar(pracovnikId: String, tovarId: String): void
  +ulozTovar(pracovnikId: String): void
  +vytvorTovar(id: String, nazov: String, vaha: int, odosielatel: ZakaznikInfo, prijemca: ZakaznikInfo): Tovar
  +vyzdvihniTovar(tovarId: String, zakaznikId: String): void
  }

  class NenajdenaEntitaException
  class NeplatnaOperaciaException
}

package "warehouse.web.api" {
  class RiaditelApiController
  class PracovnikApiController
  class ZakaznikApiController
  class MiestnostiApiController
  class StatusController
  class DtoMapper
  class GlobalExceptionHandler
}

package "warehouse.web.view" {
  class LoginController
  class RiaditelViewController
  class PracovnikViewController
  class ZakaznikViewController
  class RolaInterceptor
  class WebConfig
}

package "warehouse.config" {
  class DataInitializer
  class WarehouseApplication
}

Miestnost <|-- VelkySklad
Miestnost <|-- MalySklad
Miestnost ..> TypMiestnosti
Osoba <|-- Pracovnik
Osoba <|-- Riaditel
MalySklad "1" -- "1" Regal : regal
VelkySklad "1" -- "*" Regal : regale
Regal "1" -- "*" Tovar : ulozeny
Tovar ..> ZakaznikInfo : odosielatel
Tovar ..> ZakaznikInfo : prijemca
Pracovnik "0..1" --> "1" Miestnost : nachadza sa
Pracovnik "0..1" --> "0..1" Tovar : drzi

SkladService --> MiestnostRepository
SkladService --> RegalRepository
SkladService --> TovarRepository
SkladService --> PracovnikRepository
SkladService --> RiaditelRepository
SkladService ..> NenajdenaEntitaException
SkladService ..> NeplatnaOperaciaException

RiaditelApiController --> SkladService
PracovnikApiController --> SkladService
ZakaznikApiController --> SkladService
MiestnostiApiController --> SkladService
RiaditelApiController --> DtoMapper
PracovnikApiController --> DtoMapper
ZakaznikApiController --> DtoMapper
MiestnostiApiController --> DtoMapper
GlobalExceptionHandler ..> NenajdenaEntitaException
GlobalExceptionHandler ..> NeplatnaOperaciaException

LoginController --> SkladService
RiaditelViewController --> SkladService
PracovnikViewController --> SkladService
ZakaznikViewController --> SkladService
WebConfig --> RolaInterceptor

DataInitializer --> MiestnostRepository
DataInitializer --> RegalRepository
DataInitializer --> RiaditelRepository

@enduml
